<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Operator ?</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #e8f0fe;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }
    .card {
      background: white;
      border-radius: 10px;
      padding: 36px 40px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.12);
      min-width: 320px;
      text-align: center;
    }
    h2 {
      color: #1a237e;
      margin-bottom: 24px;
    }
    label {
      font-size: 15px;
      color: #333;
    }
    input[type="number"] {
      width: 100%;
      padding: 10px;
      font-size: 16px;
      border: 1px solid #aaa;
      border-radius: 6px;
      box-sizing: border-box;
      margin-top: 8px;
      text-align: center;
    }
    button {
      width: 100%;
      margin-top: 16px;
      padding: 10px;
      font-size: 16px;
      background: #1a237e;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
    button:hover { background: #283593; }
    #hasil {
      margin-top: 20px;
      font-size: 20px;
      font-weight: bold;
    }
    .lulus   { color: #2e7d32; }
    .tidaklulus { color: #c62828; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Operator Pembanding &amp; Logika</h2>

    <label for="nilaiInput">Nilai (0-100):</label>
    <input type="number" id="nilaiInput" min="0" max="100" placeholder="Masukkan nilai...">
    <button onclick="cekLulus()">Cek</button>

    <div id="hasil"></div>
  </div>

  <script language="JavaScript">
    function cekLulus() {
      var nilai = Number(document.getElementById("nilaiInput").value);
      var input = document.getElementById("nilaiInput").value;

      if (input === "" || nilai < 0 || nilai > 100) {
        document.getElementById("hasil").className = "tidaklulus";
        document.getElementById("hasil").innerHTML = "⚠️ Masukkan nilai 0 - 100!";
        return;
      }

      // Operator ternary persis seperti di slide
      var hasil = (nilai >= 60) ? "Lulus" : "Tidak Lulus";

      var el = document.getElementById("hasil");
      el.className = (nilai >= 0 && nilai <= 20) ? "E" : el.className;
       el.className = (nilai >= 21 && nilai <= 64) ? "C" : el.className;
        el.className = (nilai >= 65 && nilai <= 79) ? "B" : el.className;
         el.className = (nilai >= 80 && nilai <= 100) ? "A" : el.className;

      el.innerHTML = "Hasil: " + hasil;
    }
  </script>
</body>
</html>
